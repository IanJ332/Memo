# Python virtual environment (strictly isolated per machine)
.venv/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Environment files and credentials
.env
.env.*
*.pem
*.key

# OS and Editor artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/

# Server / runtime baseline reports (machine-specific inventory)
runtime_reports/

# MemLife local runtime data and experiment artifacts
runtime/

# Machine-local context and persistent agent cache
.local/

